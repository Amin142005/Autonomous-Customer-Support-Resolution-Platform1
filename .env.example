# =============================================================================
# CloudDesk Support — Environment Variables
# =============================================================================
# Copy this file to `.env` and edit the values.
# Every variable has a sensible default in `backend/app/core/config.py`; set
# only the ones you need to override.
#
# ⚠️  Never commit `.env` — it is in `.gitignore`.
# =============================================================================

# -- Application -------------------------------------------------------------
APP_NAME=CloudDesk Support
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# -- Server ------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
WORKERS=1

# -- Database ----------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/support.db
CHECKPOINT_DB_URL=sqlite+aiosqlite:///./data/checkpoints.db

# -- LLM / AI provider -------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Ollama (local fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# OpenRouter (multi-provider fallback)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-pro-exp-03-25:free
# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=

# -- Vector embeddings -------------------------------------------------------
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# -- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# -- Authentication ----------------------------------------------------------
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# -- API ---------------------------------------------------------------------
API_PREFIX=/api/v1
RATE_LIMIT_PER_MINUTE=60

# -- Logging -----------------------------------------------------------------
LOG_LEVEL=DEBUG
LOG_FORMAT=json
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=3

# -- LangGraph ---------------------------------------------------------------
LANGGRAPH_CHECKPOINTING_ENABLED=true
WORKFLOW_MAX_STEPS=50

# -- Integrations (mock) -----------------------------------------------------
MOCK_SERVICES_ENABLED=true

# -- Knowledge base ----------------------------------------------------------
KNOWLEDGE_DIR=sample_data/knowledge_base
CHUNK_SIZE=512
CHUNK_OVERLAP=50
